            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "passengerNames": {
            "maxLength": 255,
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateFlightDto": {
