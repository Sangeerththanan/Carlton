          "arrivalTime": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "seatsAvailable": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header using the Bearer scheme. Enter 'Bearer' [space] and then your token.",
