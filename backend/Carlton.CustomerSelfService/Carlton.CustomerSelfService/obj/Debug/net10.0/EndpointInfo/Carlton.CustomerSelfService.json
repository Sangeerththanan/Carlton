          "departureTime": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalTime": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "seatsAvailable": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
